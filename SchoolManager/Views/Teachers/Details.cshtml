@model SchoolManager.Data.Entities.Teacher

@{
    ViewData["Title"] = "Detalhes do professor";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>@Model.FullName</h1>

        <p class="text-muted">
            @Model.EmployeeNumber · @Model.Specialization
        </p>
    </div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        Editar
    </a>

</div>

<div class="card">

    <div class="card-body">

        <h5>Informação</h5>

        <dl class="row">

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Especialidade</dt>
            <dd class="col-sm-9">@Model.Specialization</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? "Ativo" : "Inativo")
            </dd>

        </dl>

        <hr />

        <h5>Disciplinas atribuídas</h5>

        @if (!Model.Disciplines.Any())
        {
            <p class="text-muted">
                Sem disciplinas atribuídas.
            </p>
        }
        else
        {
            <ul>
                @foreach (var discipline in Model.Disciplines.OrderBy(d => d.Name))
                {
                    <li>@discipline.Name</li>
                }
            </ul>
        }

    </div>

</div>

<a asp-action="Index"
   class="btn btn-link mt-3">
    Voltar aos professores
</a>