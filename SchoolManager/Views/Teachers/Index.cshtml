@model IEnumerable<SchoolManager.Data.Entities.Teacher>
@{
    ViewData["Title"] = "Professores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Professores</h1>
        <p class="text-muted">Gestão do corpo docente.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Novo professor
    </a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Nome, n.º funcionário ou especialidade" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-outline-secondary">
            Pesquisar
        </button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Não existem professores para apresentar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>N.º</th>
                    <th>Professor</th>
                    <th>Email</th>
                    <th>Especialidade</th>
                    <th>Estado</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeNumber</td>

                        <td>@item.FullName</td>

                        <td>@item.Email</td>

                        <td>@item.Specialization</td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}