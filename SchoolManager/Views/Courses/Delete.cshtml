@model SchoolManager.Data.Entities.Course

@{
    ViewData["Title"] = "Eliminar curso";
}

<h1>Eliminar curso</h1>

<div class="alert alert-warning">
    Tem a certeza de que pretende eliminar
    <strong>@Model.Name</strong>?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Código
    </dt>

    <dd class="col-sm-9">
        @Model.Code
    </dd>

    <dt class="col-sm-3">
        Curso
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>

    <dt class="col-sm-3">
        Alunos associados
    </dt>

    <dd class="col-sm-9">
        @Model.Students.Count
    </dd>

    <dt class="col-sm-3">
        Disciplinas associadas
    </dt>

    <dd class="col-sm-9">
        @Model.CourseDisciplines.Count
    </dd>

</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>