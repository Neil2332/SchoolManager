@model SchoolManager.Data.Entities.Discipline

@{
    ViewData["Title"] = "Detalhes da disciplina";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>@Model.Name</h1>
        <p class="text-muted">@Model.Code</p>
    </div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        Editar
    </a>

</div>

<div class="row">

    <div class="col-md-5">

        <div class="card">
            <div class="card-body">

                <h5>Informação</h5>

                <dl class="row">

                    <dt class="col-sm-5">Carga horária</dt>
                    <dd class="col-sm-7">@Model.WorkloadHours h</dd>

                    <dt class="col-sm-5">Professor</dt>
                    <dd class="col-sm-7">
                        @(Model.Teacher?.FullName ?? "Não atribuído")
                    </dd>

                    <dt class="col-sm-5">Inscrições</dt>
                    <dd class="col-sm-7">
                        @Model.Enrollments.Count
                    </dd>

                </dl>

            </div>
        </div>

    </div>

    <div class="col-md-7">

        <div class="card mb-3">
            <div class="card-body">

                <h5>Cursos associados</h5>

                @if (!Model.CourseDisciplines.Any())
                {
                    <p class="text-muted">
                        Esta disciplina ainda não está associada a cursos.
                    </p>
                }
                else
                {
                    <table class="table">

                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th>Semestre</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.CourseDisciplines
                                                    .OrderBy(cd => cd.Semester))
                            {
                                <tr>
                                    <td>@item.Course?.Name</td>
                                    <td>@(item.Semester).º</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                }

            </div>
        </div>

    </div>

</div>

<a asp-action="Index"
   class="btn btn-link mt-3">
    Voltar às disciplinas
</a>