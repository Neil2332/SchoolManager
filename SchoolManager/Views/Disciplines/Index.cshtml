@model IEnumerable<SchoolManager.Data.Entities.Discipline>

@{
    ViewData["Title"] = "Disciplinas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Disciplinas</h1>
        <p class="text-muted">Gestão das unidades curriculares.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nova disciplina
    </a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Código ou nome" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-outline-secondary">
            Pesquisar
        </button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Não existem disciplinas para apresentar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Disciplina</th>
                    <th>Horas</th>
                    <th>Professor</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.WorkloadHours h</td>
                        <td>
                            @(item.Teacher?.FullName ?? "Não atribuído")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}