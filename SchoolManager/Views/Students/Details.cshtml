@model SchoolManager.Data.Entities.Student

@{
    ViewData["Title"] = "Detalhes do aluno";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>@Model.FullName</h1>

        <p class="text-muted">
            @Model.StudentNumber
        </p>
    </div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        Editar
    </a>

</div>

<div class="row">

    <div class="col-md-5">

        <div class="card">

            <div class="card-body">

                <h5>Informação</h5>

                <dl class="row">

                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@Model.Email</dd>

                    <dt class="col-sm-5">Nascimento</dt>
                    <dd class="col-sm-7">
                        @Model.BirthDate.ToString("dd/MM/yyyy")
                    </dd>

                    <dt class="col-sm-5">Curso</dt>
                    <dd class="col-sm-7">
                        @Model.Course?.Name
                    </dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">
                        @(Model.IsActive ? "Ativo" : "Inativo")
                    </dd>

                </dl>

            </div>

        </div>

    </div>

    <div class="col-md-7">

        <div class="card">

            <div class="card-body">

                <h5>Inscrições</h5>

                @if (!Model.Enrollments.Any())
                {
                    <p class="text-muted">
                        O aluno ainda não possui inscrições.
                    </p>
                }
                else
                {
                    <table class="table">

                        <thead>
                            <tr>
                                <th>Disciplina</th>
                                <th>Estado</th>
                                <th>Nota</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrollment in Model.Enrollments)
                            {
                                <tr>
                                    <td>
                                        @enrollment.Discipline?.Name
                                    </td>

                                    <td>
                                        @enrollment.Status
                                    </td>

                                    <td>
                                        @(enrollment.FinalGrade?.ToString("0.##") ?? "-")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </div>

    </div>

</div>

<a asp-action="Index"
   class="btn btn-link mt-3">
    Voltar aos alunos
</a>