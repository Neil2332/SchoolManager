@model SchoolManager.Data.Entities.Student

@{
    ViewData["Title"] = "Eliminar aluno";
}

<h1>Eliminar aluno</h1>

<div class="alert alert-warning">
    Tem a certeza de que pretende eliminar
    <strong>@Model.FullName</strong>?
</div>

<dl class="row">

    <dt class="col-sm-3">N.º aluno</dt>
    <dd class="col-sm-9">@Model.StudentNumber</dd>

    <dt class="col-sm-3">Curso</dt>
    <dd class="col-sm-9">@Model.Course?.Name</dd>

    <dt class="col-sm-3">Inscrições</dt>
    <dd class="col-sm-9">@Model.Enrollments.Count</dd>

</dl>

@if (Model.Enrollments.Any())
{
    <div class="alert alert-danger">
        Este aluno possui inscrições e não poderá ser eliminado.
    </div>
}

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>