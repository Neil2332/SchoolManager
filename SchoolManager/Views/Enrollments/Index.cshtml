@model IEnumerable<SchoolManager.Data.Entities.Enrollment>

@{
    ViewData["Title"] = "Inscrições";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>Inscrições</h1>
        <p class="text-muted">
            Relação entre alunos e disciplinas.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Nova inscrição
    </a>

</div>

<form method="get"
      class="row g-2 mb-3">

    <div class="col-md-6">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Aluno ou disciplina" />
    </div>

    <div class="col-auto">
        <button type="submit"
                class="btn btn-outline-secondary">
            Pesquisar
        </button>
    </div>

</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Não existem inscrições para apresentar.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Aluno</th>
                    <th>Disciplina</th>
                    <th>Data</th>
                    <th>Estado</th>
                    <th>Nota</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.Student?.FullName
                        </td>

                        <td>
                            @item.Discipline?.Name
                        </td>

                        <td>
                            @item.EnrollmentDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.Status
                        </td>

                        <td>
                            @(item.FinalGrade?.ToString("0.##") ?? "-")
                        </td>

                        <td class="text-end">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}